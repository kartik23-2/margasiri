DATABASE_URL="postgresql://placeholder"

# Supabase Auth + Postgres.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Enable Google inside Supabase Auth Providers, then paste Google Cloud OAuth credentials there.
# Create GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET in Google Cloud Console under
# OAuth consent screen + Credentials before Google sign-in works outside localhost.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public Mapbox access token used by the in-app journey map and Directions API.
# Create one in a Mapbox account; never commit a real secret token here.
NEXT_PUBLIC_MAPBOX_TOKEN=""

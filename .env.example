DATABASE_URL="postgresql://placeholder"

# Supabase Auth + Postgres.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Enable Google inside Supabase Auth Providers, then paste Google Cloud OAuth credentials there.
# Create GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET in Google Cloud Console under
# OAuth consent screen + Credentials before Google sign-in works outside localhost.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenStreetMap-based map rendering. Use a managed vector style URL from MapTiler,
# Stadia Maps, Geoapify, or your own tileserver-gl style JSON. Do not use the
# public tile.openstreetmap.org server for a production app.
NEXT_PUBLIC_TILE_PROVIDER_URL=""

# Private self-hosted OSRM base URL, server-side only. Example:
# http://10.0.0.12:5000
OSRM_SERVER_URL=""
